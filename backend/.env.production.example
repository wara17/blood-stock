# Production Environment Template
# Copy this to .env and update with your production values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blood_stock_db
DB_USER=postgres
DB_PASSWORD=mysecretpassword

# Database Type (postgresql, mysql, sqlite, mssql)
DB_TYPE=postgresql

# Application Configuration
NODE_ENV=production
PORT=3002

# JWT Secret (MUST be changed to a strong secret)
# JWT_SECRET=your_very_strong_jwt_secret_here_change_this
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_this_in_production

# JWT Token Expiration
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: Database SSL Configuration
DB_SSL=true

# Optional: Logging Level
LOG_LEVEL=info