# Blood Stock Management System - Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_NAME=blood_stock_production
DB_USER=blood_stock_user
DB_PASSWORD=your_strong_database_password_here

# JWT Configuration  
JWT_SECRET=your_very_strong_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Port Configuration
FRONTEND_PORT=80
PROXY_PORT=443

# Optional: If using SSL proxy
SSL_CERT_PATH=/path/to/your/ssl/cert.pem
SSL_KEY_PATH=/path/to/your/ssl/private.key